# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=tamra
POSTGRES_USER=tamra
POSTGRES_PASSWORD=tamra
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Leave empty to disable Sentry locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

OFF_USER_AGENT=TAMRA/0.1 (contact@example.com)
OFF_BASE_URL=https://world.openfoodfacts.org

# Secret for hashing emails/devices in the free-trial check. Generate once, never change.
TRIAL_HASH_KEY=change-me-to-a-long-random-value
